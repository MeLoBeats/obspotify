# Production : copier en .env.production (lu par compose.yml). Dev local : .env.
# (DB_FILE_NAME, SPOTIFY_REDIRECT_URI, PORT et NODE_ENV sont définis par compose.yml.)

# Dashboard Spotify : https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Mot de passe pour utiliser /spotify/login?key=...
# Générer : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=

# --- Uniquement pour le développement local ---
# DB_FILE_NAME=file:db.sqlite
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback
