{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  // Config utilisée par l'éditeur : couvre aussi drizzle.config.ts.
  // Le build (npm run build) utilise tsconfig.build.json.
  "include": ["src", "drizzle.config.ts"],
  "exclude": ["node_modules"]
}
